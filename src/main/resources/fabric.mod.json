      "org.dx.show_my_maps.client.Show_my_mapsDataGenerator"
    ],
    "client": [
      "org.dx.show_my_maps.client.Show_my_mapsClient"
    ],
    "main": [
      "org.dx.show_my_maps.Show_my_maps"
    ],
    "modmenu": [
