hs_err_pid*

# Common working directory
run

# Stonecutter puts a dev run directory in each version project
versions/*/run/

# Paper plugin build output
paper-plugin/build/
paper-plugin/.gradle/

# Stub auction fixture build output
paper-plugin/stub-auction/build/
paper-plugin/stub-auction/.gradle/

# Map exporter build output
map-export/build/
map-export/.gradle/

# Stonecutter writes a per-version output directory the IDE picks up
versions/*/bin/

# VS Code
.vscode/
